# =============================================================================
# TTP CONTROL — Environment template
# =============================================================================
# Copy this file to `.env` and fill in the real values.
#
#   cp .env.example .env
#
# NEVER commit `.env`. If a token is ever exposed (pasted in chat, pushed to
# Git, printed in a log), consider it COMPROMISED and regenerate it from the
# Discord Developer Portal immediately.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Discord application
# -----------------------------------------------------------------------------
# Bot token — Developer Portal > Application > Bot > Reset Token
DISCORD_TOKEN=
# Application ID — Developer Portal > Application > General Information
CLIENT_ID=
# The TTP - Impero guild (server) ID
GUILD_ID=
# Discord user ID of the server owner (always full bot admin)
OWNER_ID=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite for now. Migrating to PostgreSQL later only requires changing this
# URL and the Prisma datasource provider — no business logic changes.
DATABASE_URL="file:../data/ttp-control.db"

# =============================================================================
# ROLE IDS
# =============================================================================
# Right click a role in Discord (Developer Mode ON) > Copy Role ID.
# NEVER identify a role by its display name — names change, IDs do not.

# --- Membership ------------------------------------------------------------
# ✅ Verified — allowed to hang around the Discord (NOT a TTP member)
ROLE_VERIFIED_ID=
# 🩸 TTP — actual gang member
ROLE_TTP_ID=

# --- TTP hierarchy (lowest -> highest) -------------------------------------
# 🏠 Resident
ROLE_RESIDENT_ID=
# 🥷 Gangster
ROLE_GANGSTER_ID=
# 🩸 Young OG
ROLE_YOUNG_OG_ID=
# 💎 Big
ROLE_BIG_ID=
# 👑 OG
ROLE_OG_ID=

# --- Community / relations -------------------------------------------------
# 🤝 Friend
ROLE_FRIEND_ID=
# 🎩 Mafia
ROLE_MAFIA_ID=

# --- Status ----------------------------------------------------------------
# 🚫 Banned
ROLE_BANNED_ID=
# 💤 Inactive
ROLE_INACTIVE_ID=
# ☠️ Permadeath
ROLE_PERMADEATH_ID=

# --- Badges ----------------------------------------------------------------
# 🎖️ Honor 1
ROLE_HONOR_1_ID=
# 🏅 Honor 2
ROLE_HONOR_2_ID=
# 🎁 Supporter
ROLE_SUPPORTER_ID=
# 🕰️ First Day
ROLE_FIRST_DAY_ID=

# --- Specializations -------------------------------------------------------
# 🎯 Shooter
ROLE_SHOOTER_ID=
# 👑 Main Shooter
ROLE_MAIN_SHOOTER_ID=

# =============================================================================
# CHANNEL IDS
# =============================================================================
# Right click a channel > Copy Channel ID.

# Public channel (ENTRANCE) hosting the persistent verify panel
CHANNEL_VERIFY_ID=
# Leadership-only channel receiving incoming verification requests
CHANNEL_VERIFY_REQUESTS_ID=
# Leadership-only channel for member management panels
CHANNEL_MEMBER_MANAGEMENT_ID=
# Channel receiving member lifecycle logs (join / promote / remove ...)
CHANNEL_MEMBER_LOGS_ID=
# Channel receiving the full administrative audit trail
CHANNEL_AUDIT_LOG_ID=
# Leadership-only channel for blacklist alerts
CHANNEL_BLACKLIST_ID=
# Channel hosting the persistent control panel
CHANNEL_CONTROL_PANEL_ID=
