# =============================================================================
# TTP CONTROL — Environment configuration
# =============================================================================
# Copia questo file in `.env` e riempi SOLO i valori segreti.
# Il file `.env` NON deve mai essere committato.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Discord secrets  (NON committare mai valori reali)
# -----------------------------------------------------------------------------
DISCORD_TOKEN=

# -----------------------------------------------------------------------------
# Discord application
# -----------------------------------------------------------------------------
CLIENT_ID=1538909559081541693
GUILD_ID=1538885185029017682
OWNER_ID=1090629136566988860

# -----------------------------------------------------------------------------
# Database — PostgreSQL / Neon  (NON committare mai valori reali)
# -----------------------------------------------------------------------------
# DATABASE_URL : endpoint POOLED di Neon (host con suffisso "-pooler").
#                Usato a runtime dal bot tramite il driver adapter Prisma.
#
# DIRECT_URL   : endpoint DIRETTO / unpooled di Neon (host senza "-pooler").
#                Usato solo dalla Prisma CLI (migrate / db pull / studio),
#                perche' le operazioni DDL non funzionano in modo affidabile
#                attraverso il connection pooler.
#                Se omesso, la CLI ricade su DATABASE_URL.
#
# Entrambe le stringhe devono includere `?sslmode=require`.
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Membership roles
# -----------------------------------------------------------------------------
# ATTENZIONE: Verified != TTP. Vedi README, sezione "Verified vs TTP".
ROLE_VERIFIED_ID=1538885185443991599
ROLE_TTP_ID=1538885185443991595

