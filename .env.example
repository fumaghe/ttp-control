# =============================================================================
# TTP CONTROL — Environment configuration
# =============================================================================
# Questo file documenta OGNI variabile che il bot legge, indipendentemente da
# dove giri.
#
# In PRODUZIONE (Cloudflare Workers) queste variabili NON stanno qui:
#   - gli ID Discord (non sensibili) vanno in `vars` dentro wrangler.jsonc;
#   - i secret si caricano con `npx wrangler secret put <NOME>`.
#
# In LOCALE serve un `.env` vero, usato da:
#   - `npm run commands:deploy` (registrazione degli slash command);
#   - la Prisma CLI (`prisma migrate`, `prisma studio`).
#
#   cp .env.example .env
#
# Il file `.env` NON deve mai essere committato.
# =============================================================================

# -----------------------------------------------------------------------------
# Discord secrets  (NON committare mai valori reali)
# -----------------------------------------------------------------------------
# Bot token: Developer Portal -> Bot -> Reset Token.
# In produzione:  npx wrangler secret put DISCORD_TOKEN
DISCORD_TOKEN=

# Public Key Ed25519 dell'APPLICAZIONE.
#
#   ATTENZIONE: NON e' il bot token. Sono due cose diverse.
#
#   Dove si trova : Developer Portal -> la tua Application
#                   -> General Information -> Public Key
#   Che aspetto ha: 64 caratteri esadecimali (32 byte), es.
#                   4f8b2c...  (nessun punto, nessun segmento)
#
# Serve a verificare la firma di OGNI richiesta che Discord invia
# all'Interactions Endpoint URL. Senza, il Worker non puo' distinguere una
# interaction autentica da un POST inviato da chiunque conosca l'URL.
#
# Non e' tecnicamente un segreto (e' pubblica), ma si carica comunque come
# secret per non tenerla in un file di configurazione versionato:
#   npx wrangler secret put DISCORD_PUBLIC_KEY
DISCORD_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Discord application
# -----------------------------------------------------------------------------
CLIENT_ID=1538909559081541693
GUILD_ID=1538885185029017682
OWNER_ID=1090629136566988860

# -----------------------------------------------------------------------------
# Database — PostgreSQL / Neon  (NON committare mai valori reali)
# -----------------------------------------------------------------------------
# Su Cloudflare Workers il percorso raccomandato e' HYPERDRIVE: il binding
# fornisce da se' la connection string a runtime, e DATABASE_URL diventa solo
# il fallback (usato da `wrangler dev` senza binding).
#
# DATABASE_URL : endpoint POOLED di Neon (host con suffisso "-pooler").
#                Fallback a runtime quando Hyperdrive non e' configurato.
#
# DIRECT_URL   : endpoint DIRETTO / unpooled di Neon (host senza "-pooler").
#                Usato solo dalla Prisma CLI (migrate / db pull / studio),
#                perche' le operazioni DDL non funzionano in modo affidabile
#                attraverso il connection pooler.
#                Se omesso, la CLI ricade su DATABASE_URL.
#
# Entrambe le stringhe devono includere `?sslmode=require`.
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Membership roles
# -----------------------------------------------------------------------------
# ATTENZIONE: Verified != TTP. Vedi README, sezione "Verified vs TTP".
ROLE_VERIFIED_ID=1538885185443991599
ROLE_TTP_ID=1538885185443991595

