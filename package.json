{
  "name": "ttp-control",
  "version": "0.1.0",
  "private": true,
  "description": "TTP Control \u2014 gestionale Discord interno per la gang FiveM GTA RP \"TTP \u2014 Impero\", su Cloudflare Workers",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail",
    "worker:build": "wrangler deploy --dry-run --outdir dist/worker",
    "build": "npm run prisma:generate && npm run worker:build",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "commands:deploy": "tsx scripts/deploy-commands.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@discordjs/builders": "1.14.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "discord-api-types": "0.38.53"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "dotenv": "17.4.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  }
}
